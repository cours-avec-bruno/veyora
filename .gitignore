# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.claude/

# generated responsive images
/public/images/_opt/

# Guides — la chaîne de fabrication est versionnée, le produit ne l'est pas.
# Le dépôt est public : ni le PDF vendu, ni le texte éditorial qu'il contient,
# ni les médias téléchargés n'y ont leur place.
guides/*/out/
guides/*/assets/photos/
guides/*/assets/print/
guides/*/assets/candidates/
guides/*/data/dest-*.mjs
guides/*/data/editorial.mjs
guides/*/data/meta.mjs
